### ==================================================
### N8N
### ==================================================
### Configurações Gerais
SERVER_URL=https://meu-site.com
DEL_INSTANCE=boolean
DEL_TEMP_INSTANCES=boolean

### Provedor e Instância
PROVIDER_ENABLED=boolean
PROVIDER_HOST=000.0.0.0
PROVIDER_PORT=0000
PROVIDER_PREFIX=meu-app

### Banco de Dados (Principal)
DATABASE_ENABLED=boolean
DATABASE_PROVIDER=postgresql
# Formato: protocolo://usuario:senha@host:porta/database
DATABASE_CONNECTION_URI=protocolo://usuario:senha@host:porta/database
DATABASE_CONNECTION_CLIENT_NAME=meu-app

### AWS SQS (Fila de Mensagens)
SQS_ENABLED=boolean
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
SQS_ACCOUNT_ID=
SQS_REGION=

### WebSocket & WhatsApp Business API
WEBSOCKET_ENABLED=boolean
WEBSOCKET_GLOBAL_EVENTS=boolean
WA_BUSINESS_TOKEN_WEBHOOK=meu-site
WA_BUSINESS_URL=https://meu.site.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=pt_BR

### Webhooks Globais e Eventos
# URL para onde as notificações serão enviadas
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_ENABLED=boolean
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=boolean
WEBHOOK_EVENTS_APPLICATION_STARTUP=boolean
WEBHOOK_EVENTS_QRCODE_UPDATED=boolean
WEBHOOK_EVENTS_MESSAGES_SET=boolean
WEBHOOK_EVENTS_MESSAGES_UPSERT=boolean
WEBHOOK_EVENTS_MESSAGES_EDITED=boolean
WEBHOOK_EVENTS_MESSAGES_UPDATE=boolean
WEBHOOK_EVENTS_MESSAGES_DELETE=boolean
WEBHOOK_EVENTS_SEND_MESSAGE=boolean
WEBHOOK_EVENTS_CONTACTS_SET=boolean
WEBHOOK_EVENTS_CONTACTS_UPSERT=boolean
WEBHOOK_EVENTS_CONTACTS_UPDATE=boolean
WEBHOOK_EVENTS_PRESENCE_UPDATE=boolean
WEBHOOK_EVENTS_CHATS_SET=boolean
WEBHOOK_EVENTS_CHATS_UPSERT=boolean
WEBHOOK_EVENTS_CHATS_UPDATE=boolean
WEBHOOK_EVENTS_CHATS_DELETE=boolean
WEBHOOK_EVENTS_GROUPS_UPSERT=boolean
WEBHOOK_EVENTS_GROUPS_UPDATE=boolean
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=boolean
WEBHOOK_EVENTS_CONNECTION_UPDATE=boolean
WEBHOOK_EVENTS_LABELS_EDIT=boolean
WEBHOOK_EVENTS_LABELS_ASSOCIATION=boolean
WEBHOOK_EVENTS_CALL=boolean
WEBHOOK_EVENTS_TYPEBOT_START=boolean
WEBHOOK_EVENTS_TYPEBOT_CHANGE_STATUS=boolean
WEBHOOK_EVENTS_ERRORS=boolean
WEBHOOK_EVENTS_ERRORS_WEBHOOK=

### Configurações de Sessão e QR Code
CONFIG_SESSION_PHONE_CLIENT=navegador
CONFIG_SESSION_PHONE_NAME=navegador
QRCODE_LIMIT=0
QRCODE_COLOR=#000000

### Integrações de IA e Chatbots
OPENAI_ENABLED=boolean
DIFY_ENABLED=boolean
TYPEBOT_ENABLED=boolean
TYPEBOT_API_VERSION=ultima

### Integração Chatwoot
CHATWOOT_ENABLED=boolean
CHATWOOT_MESSAGE_READ=boolean
# URI de importação do banco de dados do Chatwoot
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=mysql://usuario:senha@host_do_banco:3306/nome_do_banco
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=boolean

### Cache e Redis
CACHE_REDIS_ENABLED=boolean
# Formato: redis://default:senha@host:porta/db_index
CACHE_REDIS_URI=redis://default:senha_opcional@host_do_redis:6379/0
CACHE_REDIS_PREFIX_KEY=meu-app
CACHE_REDIS_SAVE_INSTANCES=boolean
CACHE_LOCAL_ENABLED=boolean

### Armazenamento de Arquivos (S3)
S3_ENABLED=boolean
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=meusite
S3_PORT=000
S3_ENDPOINT=
S3_USE_SSL=boolean

### Autenticação e Segurança
# Chave mestra para acessar a API
AUTHENTICATION_API_KEY=sua_api_key
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=boolean
LANGUAGE=pt-BR

### ==================================================
### N8N
### ==================================================

### Configurações de Banco de Dados (Postgres)
DB_TYPE=postgresdb
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_HOST=host_do_container_postgres
DB_POSTGRESDB_DATABASE=nome_do_banco
DB_POSTGRESDB_USER=usuario_postgres
DB_POSTGRESDB_PASSWORD=sua_senha_forte_aqui

### Segurança e Criptografia
# CHAVE CRÍTICA: Use uma string aleatória longa. Se perder, perderá acesso aos dados criptografados.
N8N_ENCRYPTION_KEY=sua_chave_de_criptografia_aqui
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

### Configurações de Rede e Host
N8N_HOST=seu-dominio-editor.com
N8N_EDITOR_BASE_URL=https://seu-dominio-editor.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://seu-dominio-webhook.com
NODE_ENV=production

### Execução e Escalabilidade (Queue Mode)
EXECUTIONS_MODE=queue
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_RUN_MIGRATIONS=true

### Redis (Fila Bull)
QUEUE_BULL_REDIS_HOST=host_do_container_redis
QUEUE_BULL_REDIS_PASSWORD=sua_senha_redis_aqui
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=2

### Segurança de Código
# Permite o uso de bibliotecas externas nas funções do n8n
NODE_FUNCTION_ALLOW_EXTERNAL=*

### Retenção de Dados (Pruning)
# Remove execuções antigas para não lotar o banco
EXECUTIONS_DATA_PRUNE=true
# Tempo máximo em horas (ex: 336h = 14 dias)
EXECUTIONS_DATA_MAX_AGE=336

### Localização
GENERIC_TIMEZONE=America/Sao_Paulo

### Configurações de E-mail (SMTP - Gmail exemplo)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_USER=seu_email@gmail.com
# Use uma "Senha de App" se for Gmail, nunca a senha principal
N8N_SMTP_PASS=sua_senha_de_app_aqui
N8N_SMTP_PORT=465
N8N_SMTP_SSL=true
N8N_SMTP_TLS=false
N8N_EMAIL_FROM=seu_email@gmail.com
N8N_EMAIL_FROM_NAME=evolutionAK

### ==================================================
### N8N
### ==================================================

### Banco de Dados (PostgreSQL)
DB_TYPE=postgresdb
DB_POSTGRESDB_PORT=5432
# Nome do serviço/container no Docker ou Easypanel
DB_POSTGRESDB_HOST=host_do_container_postgres
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=sua_senha_forte_aqui

### Segurança e Criptografia
# CHAVE CRÍTICA: Se mudar isso depois de criar workflows, você perde acesso às credenciais salvas.
N8N_ENCRYPTION_KEY=sua_chave_aleatoria_longa_aqui
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

### Configurações de Host e URLs
# Certifique-se de usar apenas o domínio ou a URL completa conforme a exigência da versão
N8N_HOST=seu-dominio-editor.com
N8N_EDITOR_BASE_URL=https://seu-dominio-editor.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://seu-dominio-webhook.com
NODE_ENV=production

### Execução e Migrações
# 'queue' é ideal para produções robustas usando Redis
EXECUTIONS_MODE=queue
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_RUN_MIGRATIONS=true
N8N_RUNNERS_ENABLED=true

### Redis (Fila Bull)
QUEUE_BULL_REDIS_HOST=host_do_container_redis
QUEUE_BULL_REDIS_PASSWORD=sua_senha_redis_aqui
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=2

### Permissões de Código
# Permite importar bibliotecas externas (ex: axios, moment) dentro dos nós de função
NODE_FUNCTION_ALLOW_EXTERNAL=*

### Gerenciamento de Dados (Limpeza Automática)
EXECUTIONS_DATA_PRUNE=true
# Tempo em horas para manter o histórico (336h = 14 dias)
EXECUTIONS_DATA_MAX_AGE=336
GENERIC_TIMEZONE=America/Sao_Paulo

### Configurações de E-mail (SMTP)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_USER=seu_email@gmail.com
# Para Gmail, use uma 'Senha de App' gerada na sua conta Google
N8N_SMTP_PASS=sua_senha_de_app_aqui
N8N_SMTP_PORT=465
N8N_SMTP_SSL=true
N8N_SMTP_TLS=false
N8N_EMAIL_FROM=seu_email@gmail.com
N8N_EMAIL_FROM_NAME=evolutionAK

### ==================================================
### N8N
### ==================================================

### Banco de Dados (PostgreSQL)
DB_TYPE=postgresdb
DB_POSTGRESDB_PORT=5432
# Nome do serviço no Docker/Easypanel
DB_POSTGRESDB_HOST=host_do_container_postgres
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=sua_senha_banco_aqui

### Segurança e Criptografia
# CHAVE MESTRA: Se mudar isso depois, perde acesso às credenciais salvas nos workflows
N8N_ENCRYPTION_KEY=sua_chave_de_criptografia_longa_aqui
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

### URLs e Domínios
N8N_HOST=seu-dominio-editor.com
N8N_EDITOR_BASE_URL=https://seu-dominio-editor.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://seu-dominio-webhook.com
NODE_ENV=production

### Execução e Performance
# 'queue' utiliza Redis para gerenciar alta demanda
EXECUTIONS_MODE=queue
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_RUN_MIGRATIONS=true
N8N_RUNNERS_ENABLED=true

### Redis (Fila Bull)
QUEUE_BULL_REDIS_HOST=host_do_container_redis
QUEUE_BULL_REDIS_PASSWORD=sua_senha_redis_aqui
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=2

### Permissões e Funções
# Permite usar pacotes NPM externos nos nós de função
NODE_FUNCTION_ALLOW_EXTERNAL=*

### Limpeza e Localização
EXECUTIONS_DATA_PRUNE=true
# Mantém histórico por 14 dias (336h)
EXECUTIONS_DATA_MAX_AGE=336
GENERIC_TIMEZONE=America/Sao_Paulo

### Configurações de E-mail (SMTP)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_USER=seu_email@gmail.com
# Use 'Senha de App' do Google, nunca a senha real da conta
N8N_SMTP_PASS=sua_senha_de_app_aqui
N8N_SMTP_PORT=465
N8N_SMTP_SSL=true
N8N_SMTP_TLS=false
N8N_EMAIL_FROM=seu_email@gmail.com
N8N_EMAIL_FROM_NAME=evolutionAK

### ==================================================
### N8N
### ==================================================

### Configurações do Banco de Dados (Postgres - Easypanel)

# Usuário padrão do banco (no print: postgres)
DB_USER=usuario_aqui

# Senha do banco (aquela que aparece escondida com pontos no print)
DB_PASSWORD=sua_senha_aqui

# Nome do banco de dados (no print: evolution-ak)
DB_NAME=nome_do_banco

# Host interno usado para comunicação entre containers (no print: evolution-ak_postgres)
DB_HOST=host_interno_aqui

# Porta padrão do Postgres (no print: 5432)
DB_PORT=5432

### URLs de Conexão (Geradas automaticamente pelo Easypanel)
# Formato sugerido para documentação: postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
INTERNAL_CONNECTION_URL=postgresql://usuario:senha@host:5432/banco

### ==================================================
### N8N
### ==================================================

### Configurações do Cache (Redis - Easypanel)

# Usuário padrão (no print: default)
REDIS_USER=default

# Senha do Redis (escondida no print)
REDIS_PASSWORD=sua_senha_redis_aqui

# Host interno para comunicação entre containers (no print: evolution-ak_redis)
REDIS_HOST=host_interno_redis_aqui

# Porta padrão do Redis (no print: 6379)
REDIS_PORT=6379

### URLs de Conexão
# Formato para n8n ou APIs: redis://usuario:senha@host:porta/db_index
# O Easypanel geralmente usa o DB 0 por padrão
REDIS_INTERNAL_CONNECTION_URL=redis://default:senha@host:6379/0
