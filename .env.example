### Configurações de Sessão e QR Code
CONFIG_SESSION_PHONE_CLIENT=navegador
CONFIG_SESSION_PHONE_NAME=navegador
QRCODE_LIMIT=0
QRCODE_COLOR=#000000

### Integrações de IA e Chatbots
OPENAI_ENABLED=boolean
DIFY_ENABLED=boolean
TYPEBOT_ENABLED=boolean
TYPEBOT_API_VERSION=ultima

### Integração Chatwoot
CHATWOOT_ENABLED=boolean
CHATWOOT_MESSAGE_READ=boolean
# URI de importação do banco de dados do Chatwoot
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=mysql://usuario:senha@host_do_banco:3306/nome_do_banco
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=boolean

### Cache e Redis
CACHE_REDIS_ENABLED=boolean
# Formato: redis://default:senha@host:porta/db_index
CACHE_REDIS_URI=redis://default:senha_opcional@host_do_redis:6379/0
CACHE_REDIS_PREFIX_KEY=meu-app
CACHE_REDIS_SAVE_INSTANCES=boolean
CACHE_LOCAL_ENABLED=boolean

### Armazenamento de Arquivos (S3)
S3_ENABLED=boolean
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=meusite
S3_PORT=000
S3_ENDPOINT=
S3_USE_SSL=boolean

### Autenticação e Segurança
# Chave mestra para acessar a API
AUTHENTICATION_API_KEY=sua_api_key
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=boolean
LANGUAGE=pt-BR
