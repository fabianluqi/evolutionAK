WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_ENABLED=boolean
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=boolean
WEBHOOK_EVENTS_APPLICATION_STARTUP=boolean
WEBHOOK_EVENTS_QRCODE_UPDATED=boolean
WEBHOOK_EVENTS_MESSAGES_SET=boolean
WEBHOOK_EVENTS_MESSAGES_UPSERT=boolean
WEBHOOK_EVENTS_MESSAGES_EDITED=boolean
WEBHOOK_EVENTS_MESSAGES_UPDATE=boolean
WEBHOOK_EVENTS_MESSAGES_DELETE=boolean
WEBHOOK_EVENTS_SEND_MESSAGE=boolean
